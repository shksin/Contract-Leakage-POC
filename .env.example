# Azure AI Foundry / AI Projects
AZURE_AI_PROJECT_CONNECTION_STRING=<your-project-connection-string>
AZURE_AI_MODEL_DEPLOYMENT=gpt-4o

# Azure Authentication (use DefaultAzureCredential in production)
AZURE_TENANT_ID=<your-tenant-id>
AZURE_CLIENT_ID=<your-client-id>
AZURE_CLIENT_SECRET=<your-client-secret>

# SharePoint (mock mode enabled by default for PoC)
SHAREPOINT_SITE_URL=https://<tenant>.sharepoint.com/sites/<site>
SHAREPOINT_CONTRACTS_LIBRARY=Contracts
SHAREPOINT_MOCK_MODE=true

# GCP BigQuery (mock mode enabled by default for PoC)
GCP_PROJECT_ID=<your-gcp-project>
GCP_DATASET_ID=finance_data
GCP_CREDENTIALS_PATH=<path-to-service-account-json>
BIGQUERY_MOCK_MODE=true

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
